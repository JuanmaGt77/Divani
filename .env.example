# Copia este archivo como .env (o .env.local) y ajusta los valores.
# Estos archivos NO se suben a GitHub (están en .gitignore).

# ─── Supabase (base de datos, inicio de sesión del panel y pedidos) ─────────────────────
# Supabase → Project Settings → API Keys. Sin estas dos variables la tienda y el panel
# funcionan en MODO DEMOSTRACIÓN (los datos se guardan solo en tu navegador).
VITE_SUPABASE_URL=
# La clave PUBLICABLE (sb_publishable_…). Es pública por diseño: la seguridad la dan las
# reglas de supabase/schema.sql. NUNCA pongas aquí la secret key (sb_secret_…).
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── WhatsApp de respaldo ────────────────────────────────────────────────────────────────
# El número se configura en el panel (Configuración → Tienda y contacto). Este solo se usa
# si el panel aún no tiene uno. Formato internacional, solo dígitos:
#   México 52 + 10 dígitos (525512345678) · Guatemala 502 + 8 dígitos (50255551234)
VITE_WHATSAPP_NUMBER=525500000000

# ─── Backend REST propio (opcional, en lugar de Supabase) ────────────────────────────────
# Déjala vacía si usas Supabase o la demostración. Contrato en docs/API.md.
VITE_API_URL=

# ─── Solo para `npm run setup:supabase` (se ejecuta en tu computadora) ────────────────────
# Ponlas en .env.local, nunca en el hosting ni en GitHub.
# SUPABASE_SECRET_KEY=sb_secret_…        # crea el usuario administrador
# SUPABASE_ACCESS_TOKEN=sbp_…            # opcional: ejecuta schema.sql y seed.sql por ti
# ADMIN_EMAIL=somosdivani@gmail.com
# ADMIN_PASSWORD=                        # escríbela tú; no la guardes en el código
# SITE_URL=https://tu-dominio.com
