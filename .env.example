# Copia este archivo como .env y ajusta los valores.

# Número de WhatsApp que recibe los pedidos (formato internacional, solo dígitos).
# México: 52 + tu número a 10 dígitos. Ejemplo: 525512345678
VITE_WHATSAPP_NUMBER=525500000000

# URL base de tu backend (API REST). Déjala vacía para usar los datos de prueba
# de public/data/*.json. Ejemplo: https://api.divani.mx/v1
VITE_API_URL=
