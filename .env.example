# Copia este archivo como .env.local y escribe los valores.
# .env y .env.local NO se suben a GitHub (están en .gitignore).

# ─── Supabase (base de datos, panel y pedidos) ────────────────────────────────────────────
# Supabase → Project Settings → API Keys. Son PÚBLICAS por diseño (empiezan con PUBLIC_):
# la seguridad la dan las reglas de supabase/schema.sql. Sin ellas la tienda no compila.
PUBLIC_SUPABASE_URL=
# La clave PUBLICABLE (sb_publishable_…). NUNCA pongas aquí la secret key (sb_secret_…).
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Dirección pública de la tienda (opcional) ────────────────────────────────────────────
# Cuando tengas tu dominio, escríbelo aquí y en Cloudflare: se usa en las vistas previas al
# compartir la tienda por WhatsApp o redes. Ej.: https://divani.gt
PUBLIC_SITE_URL=

# ─── Estudio IA (fotos y ficha con OpenAI) ────────────────────────────────────────────────
# NO van en este archivo: son del Worker. En Cloudflare se guardan con `npx wrangler secret put`
# y, para probar en tu computadora, en el archivo .dev.vars (tampoco se sube a GitHub):
#
# ESTUDIO_DEMO=1                # .dev.vars: modo demostración, no llama a OpenAI ni gasta saldo
# ESTUDIO_WORKER_TOKEN=         # llave de la cola; se lee de Supabase (ver docs/CONEXION.md, paso 6)
# OPENAI_API_KEY=sk-…           # clave de la API de OpenAI (no es la suscripción de ChatGPT)
#
# Opcionales: IMAGE_MODEL, IMAGE_QUALITY, IMAGE_SIZE, IMAGE_COMPLEXITY_PRENDA,
# IMAGE_COMPLEXITY_MODELO, IMAGE_MODERATION, TEXT_MODEL, TEXT_REASONING, ORIGEN,
# MAX_TRABAJOS_ACTIVOS. Sus valores y su uso están en docs/CONEXION.md, paso 6.

# ─── Solo para `npm run setup:supabase` (se ejecuta en tu computadora) ────────────────────
# Ponlas en .env.local, nunca en Cloudflare ni en GitHub. Bórralas cuando termines.
# SUPABASE_ACCESS_TOKEN=sbp_…            # ejecuta schema.sql, seed.sql y las actualizaciones
# SUPABASE_SECRET_KEY=sb_secret_…        # crea el usuario administrador
# ADMIN_EMAIL=somosdivani@gmail.com
# ADMIN_PASSWORD=                        # escríbela tú; no la guardes en el código
# CLOUDINARY_CLOUD_NAME=                 # opcional: conecta Cloudinary y prueba una subida
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
